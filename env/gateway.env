# /etc/mylocalon/gateway.env  (root:mylocalon, mode 0640)
ML_ENV=production
ML_LOG_LEVEL=info
ML_LISTEN_ADDR=127.0.0.1:7002
ML_ADMIN_ADDR=127.0.0.1:7003
ML_BASE_DOMAIN=mylocalon.com
ML_PUBLIC_SCHEME=https
ML_PUBLIC_PORT=
ML_TRUST_PROXY=true
ML_REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:6379/0
ML_JWKS_URL=http://127.0.0.1:3001/api/v1/jwks
ML_JWT_PUBLIC_KEYS=
ML_JWT_ISSUER=mylocalon-platform
ML_JWT_AUDIENCE=mylocalon-gateway
ML_PLATFORM_URL=http://127.0.0.1:3001
ML_INTERNAL_TOKEN=SAME_AS_PLATFORM_INTERNAL_API_TOKEN
ML_MAX_BODY_BYTES=10485760
ML_MAX_TUNNELS_PER_USER=5
ML_CONN_RATE_PER_MIN=30
ML_REQ_RATE_PER_SEC=100
ML_IP_REQ_RATE_PER_SEC=50
ML_BLOCKED_SUBDOMAINS=
