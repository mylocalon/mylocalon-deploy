# /etc/mylocalon/platform.env  (root:mylocalon, mode 0640)
NODE_ENV=production
DATABASE_URL=postgres://mylocalon:DB_PASSWORD@127.0.0.1:5432/mylocalon
BASE_URL=https://mylocalon.com
BASE_DOMAIN=mylocalon.com
TUNNEL_URL_SCHEME=https
TUNNEL_URL_PORT=
JWT_KID=k1
# JWT_PRIVATE_KEY_PATH is set by the unit from systemd credentials.
JWT_EXTRA_PUBLIC_KEYS=
JWT_ISSUER=mylocalon-platform
JWT_AUDIENCE=mylocalon-gateway
JWT_TTL_SECONDS=3600
INTERNAL_API_TOKEN=GENERATE_WITH_openssl_rand_hex_32
LOG_LEVEL=info
